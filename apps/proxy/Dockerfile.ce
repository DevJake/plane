FROM caddy:2.11.7-builder-alpine@sha256:ef9b65adf9a224770c6d5f6d1ae1bf99bc3caaa78d8c4bae3ea949ee6984f301 AS caddy-builder

RUN xcaddy build \
        --with github.com/caddy-dns/cloudflare@v0.2.4 \
        --with github.com/caddy-dns/digitalocean@04bde2867106aa1b44c2f9da41a285fa02e629c5 \
        --with github.com/mholt/caddy-l4@v0.1.2 \
        --with github.com/go-jose/go-jose/v3@v3.0.5 \
        --with github.com/go-jose/go-jose/v4@v4.1.6 \
        --with google.golang.org/grpc@v1.84.0 \
        --with go.opentelemetry.io/otel@v1.47.0 \
        --with go.opentelemetry.io/otel/sdk@v1.47.0

FROM caddy:2.11.7-alpine@sha256:eb4d35b7452d1ab6171fbdbe8d9275b2301dad6dad92115d91e19fb9b24d510f

RUN apk update && apk upgrade --no-cache && apk add --no-cache nss-tools bash curl

COPY --from=caddy-builder /usr/bin/caddy /usr/bin/caddy

COPY Caddyfile.ce /etc/caddy/Caddyfile